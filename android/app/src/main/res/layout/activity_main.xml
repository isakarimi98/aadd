<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:orientation="vertical"
    android:background="#F8FAFC"
    tools:context=".MainActivity">

    <!-- App Header / Toolbar -->
    <RelativeLayout
        android:layout_width="match_parent"
        android:layout_height="64dp"
        android:background="#0F766E"
        android:paddingHorizontal="16dp"
        android:elevation="4dp">

        <TextView
            android:id="@+id/tvAppTitle"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_centerVertical="true"
            android:layout_alignParentStart="true"
            android:text="فتوکپی پلاس"
            android:textColor="#FFFFFF"
            android:textSize="20sp"
            android:textStyle="bold" />

        <TextView
            android:id="@+id/tvAppSubtitle"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_centerVertical="true"
            android:layout_toEndOf="@id/tvAppTitle"
            android:layout_marginStart="8dp"
            android:text="اسکن و چاپ مدارک"
            android:textColor="#99F6E4"
            android:textSize="12sp" />
    </RelativeLayout>

    <!-- Main Workspace / Preview Area -->
    <FrameLayout
        android:id="@+id/previewContainer"
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight="1"
        android:layout_margin="16dp"
        android:background="#FFFFFF"
        android:elevation="3dp"
        android:padding="8dp">

        <!-- Empty State Prompt -->
        <LinearLayout
            android:id="@+id/layoutEmptyState"
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:gravity="center"
            android:orientation="vertical"
            android:padding="24dp">

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="📄"
                android:textSize="64sp" />

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="16dp"
                android:text="مدرک یا سندی انتخاب نشده است"
                android:textColor="#334155"
                android:textSize="17sp"
                android:textStyle="bold" />

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="8dp"
                android:gravity="center"
                android:text="با دکمه‌های زیر عکس بگیرید یا از گالری شناسنامه/کارت ملی را انتخاب کنید"
                android:textColor="#64748B"
                android:textSize="13sp" />
        </LinearLayout>

        <!-- Document Preview ImageView -->
        <ImageView
            android:id="@+id/ivDocumentPreview"
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:scaleType="fitCenter"
            android:visibility="gone"
            android:contentDescription="پیش‌نمایش مدرک" />

        <!-- Processing Indicator -->
        <ProgressBar
            android:id="@+id/progressBar"
            android:layout_width="56dp"
            android:layout_height="56dp"
            android:layout_gravity="center"
            android:visibility="gone" />
    </FrameLayout>

    <!-- Filter Modes Selector Bar -->
    <HorizontalScrollView
        android:id="@+id/filterScrollView"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:paddingHorizontal="12dp"
        android:paddingBottom="8dp"
        android:scrollbars="none">

        <LinearLayout
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:orientation="horizontal">

            <Button
                android:id="@+id/btnFilterPhotocopy"
                android:layout_width="wrap_content"
                android:layout_height="44dp"
                android:layout_marginEnd="6dp"
                android:backgroundTint="#0F766E"
                android:text="فتوکپی B&amp;W"
                android:textColor="#FFFFFF"
                android:textSize="12sp" />

            <Button
                android:id="@+id/btnFilterMagic"
                android:layout_width="wrap_content"
                android:layout_height="44dp"
                android:layout_marginEnd="6dp"
                android:backgroundTint="#E2E8F0"
                android:text="شفاف‌سازی متن"
                android:textColor="#1E293B"
                android:textSize="12sp" />

            <Button
                android:id="@+id/btnFilterGrayscale"
                android:layout_width="wrap_content"
                android:layout_height="44dp"
                android:layout_marginEnd="6dp"
                android:backgroundTint="#E2E8F0"
                android:text="خاکستری اداری"
                android:textColor="#1E293B"
                android:textSize="12sp" />

            <Button
                android:id="@+id/btnFilterOriginal"
                android:layout_width="wrap_content"
                android:layout_height="44dp"
                android:backgroundTint="#E2E8F0"
                android:text="رنگ اصلی"
                android:textColor="#1E293B"
                android:textSize="12sp" />
        </LinearLayout>
    </HorizontalScrollView>

    <!-- Contrast / Darkness Slider Controls -->
    <LinearLayout
        android:id="@+id/layoutControls"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:paddingHorizontal="16dp"
        android:paddingVertical="4dp">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="horizontal">

            <TextView
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:text="شدت سیاهی فتوکپی:"
                android:textColor="#475569"
                android:textSize="12sp" />

            <TextView
                android:id="@+id/tvThresholdValue"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="130"
                android:textColor="#0F766E"
                android:textSize="12sp"
                android:textStyle="bold" />
        </LinearLayout>

        <SeekBar
            android:id="@+id/seekThreshold"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:max="240"
            android:min="60"
            android:progress="130" />
    </LinearLayout>

    <!-- Bottom Action Bar (Capture, Gallery, Share, PDF) -->
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:background="#FFFFFF"
        android:elevation="8dp"
        android:orientation="horizontal"
        android:padding="12dp">

        <Button
            android:id="@+id/btnCamera"
            android:layout_width="0dp"
            android:layout_height="48dp"
            android:layout_weight="1"
            android:layout_marginEnd="6dp"
            android:backgroundTint="#0F766E"
            android:text="دوربین"
            android:textColor="#FFFFFF" />

        <Button
            android:id="@+id/btnGallery"
            android:layout_width="0dp"
            android:layout_height="48dp"
            android:layout_weight="1"
            android:layout_marginEnd="6dp"
            android:backgroundTint="#0284C7"
            android:text="گالری"
            android:textColor="#FFFFFF" />

        <Button
            android:id="@+id/btnExportPdf"
            android:layout_width="0dp"
            android:layout_height="48dp"
            android:layout_weight="1"
            android:layout_marginEnd="6dp"
            android:backgroundTint="#D97706"
            android:text="ذخیره PDF"
            android:textColor="#FFFFFF" />

        <Button
            android:id="@+id/btnShare"
            android:layout_width="0dp"
            android:layout_height="48dp"
            android:layout_weight="1"
            android:backgroundTint="#475569"
            android:text="اشتراک"
            android:textColor="#FFFFFF" />
    </LinearLayout>

</LinearLayout>
